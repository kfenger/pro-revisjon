---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';
interface Props { title: string; lead?: string; crumbs: Crumb[]; }
const { title, lead, crumbs } = Astro.props;
---
<header class="page-header">
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <h1 class="enter">{title}</h1>
    {lead && <p class="lead enter enter--2">{lead}</p>}
    <slot />
  </div>
</header>
