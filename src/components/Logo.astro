---
import { logo } from '../lib/images';
import { company } from '../data/site';
const img = logo();
---
{img ? (
  <img src={img.src} alt={company.name} class="logo-img" width={Math.round((img.width * 64) / img.height)} height={64} loading="eager" decoding="async" />
) : (
  <span class="wordmark">
    <span class="wordmark-name">Pro-Revisjon</span>
    <span class="wordmark-tag">Statsautoriserte revisorer</span>
  </span>
)}
