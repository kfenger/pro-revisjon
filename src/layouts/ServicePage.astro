---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import { services } from '../data/site';
interface Props { slug: string; description: string; }
const { slug, description } = Astro.props;
const service = services.find((s) => s.slug === slug)!;
const others = services.filter((s) => s.slug !== slug);
---
<Base title={service.title} description={description}>
  <header class="service-header container">
    <Breadcrumbs items={[{ label: 'Tjenester', href: '/tjenester/' }, { label: service.title, href: `/tjenester/${slug}/` }]} />
    <div class="service-header-grid">
      <div class="service-header-copy">
        <h1 class="enter">{service.title}</h1>
        <p class="lead enter enter--2">{service.lead}</p>
      </div>
      <Photo name={service.photo} alt={service.photoAlt} focus={service.photoFocus} sizes="(min-width: 56rem) 45vw, 100vw" ratio="4x3" priority class="service-header-photo" />
    </div>
  </header>

  <div class="container service-body">
  <div class="article-layout">
    <article class="prose">
      <slot />
    </article>
  </div>

  <nav class="next-links" aria-label="Andre tjenester">
    <p class="label">Andre tjenester</p>
    <ul>
      {others.map((s) => <li><a href={`/tjenester/${s.slug}/`}>{s.title} <span aria-hidden="true">→</span></a></li>)}
    </ul>
  </nav>
  </div>
</Base>
