---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import { company, services } from '../data/site';
---

<Base description="Pro-Revisjon AS er et frittstående revisjonsfirma i Kristiansand, eid og drevet av statsautoriserte revisorer. Revisjon, regnskap og rådgivning for små og mellomstore bedrifter.">
  <!-- Who we are -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow enter">Revisor i {company.city}</p>
      <h1 id="hero-title" class="enter enter--2">Trygg revisjon for små og mellomstore bedrifter</h1>
      <p class="hero-lead enter enter--3">Et frittstående revisjonsfirma, eid og drevet av statsautoriserte revisorer.</p>
      <p class="hero-actions enter enter--4">
        <a class="btn" href="/kontakt/">Ta kontakt</a>
        <a class="btn btn--secondary btn--call" href={company.phone.href}>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>Ring&nbsp;{company.phone.display}</a>
      </p>
    </div>
    <HeroSlideshow
      class="hero-media"
      sizes="(min-width: 64rem) 55vw, 100vw"
      slides={[
        { name: 'skrivebord', alt: 'Skrivebord med bærbar PC, kalkulator, regnskapsark og fakturaer i dagslys', focus: 'center' },
        { name: 'motebord', alt: '', focus: 'center' },
        { name: 'logo-glass', alt: '', focus: 'center' },
      ]}
    />
  </section>

  <!-- What we do -->
  <section class="section" aria-labelledby="tjenester-title">
    <div class="container two-col">
      <div class="two-col-label services-intro">
        <h2 id="tjenester-title" class="label">Tjenester</h2>
        <a class="text-link services-all" href="/tjenester/">Alle tjenester <span aria-hidden="true">→</span></a>
      </div>
      <ul class="index-list">
        {services.map((s) => (
          <li>
            <a href={`/tjenester/${s.slug}/`}>
              <span class="index-title">{s.title}</span>
              <span class="index-text">{s.tagline}</span>
              <span class="index-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Why us -->
  <section class="feature" aria-labelledby="hvorfor-title">
    <Photo
      name="gjennomgang"
      alt="Revisor og kunde går gjennom et regnskap sammen ved et bord"
      sizes="(min-width: 56rem) 50vw, 100vw"
      ratio="fill"
      focus="center"
      parallax
      class="feature-photo"
    />
    <div class="feature-copy">
      <h2 id="hvorfor-title">Kort vei til revisoren</h2>
      <p>
        Vi er et lite firma. Det betyr kort vei fra spørsmål til svar, og at du forholder deg til folk som kjenner
        bedriften din.
      </p>
      <ul class="credentials-line">
        <li>Godkjent revisjonsselskap</li>
        <li>Autorisert regnskapsførerselskap</li>
        <li>Medlem av Revisorforeningen</li>
      </ul>
      <a class="text-link" href="/om-oss/">Om Pro-Revisjon <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
