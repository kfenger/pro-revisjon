---
import Base from '../layouts/Base.astro';
---
<Base title="Fant ikke siden" description="Siden du leter etter finnes ikke." noindex>
  <section class="notfound">
    <div class="container">
      <p class="eyebrow">Feil 404</p>
      <h1>Vi fant ikke siden</h1>
      <p class="lead">Siden kan ha blitt flyttet eller fjernet. Prøv en av disse i stedet:</p>
      <ul class="notfound-links">
        <li><a href="/">Forsiden</a></li>
        <li><a href="/tjenester/">Tjenester</a></li>
        <li><a href="/ansatte/">Ansatte</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
      </ul>
    </div>
  </section>
</Base>
